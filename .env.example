# Copy to .env (same directory) and fill in. .env is git-ignored. Real env vars override .env.
# Safe install defaults: forward / nudge / outbox are OFF until you explicitly enable them.

# ---- feature gates (default OFF) ----
# ENABLE_WEBHOOK_FORWARD=0
# ENABLE_NUDGE=0
# ENABLE_OUTBOX=0
# After bind + webhook secret are ready, enable forward only:
# ENABLE_WEBHOOK_FORWARD=1
# Optional later: ENABLE_NUDGE=1 and/or ENABLE_OUTBOX=1 (proactive / queued sends)

# ---- required for forwarding: the Grok Bot routine webhook ----
# URL shown on your routine's Webhook trigger (https only). Treat it as a secret.
# Prefer leaving KEY empty here and using a secrets file / secure field instead of pasting into chat.
WECHAT_WEBHOOK_URL=https://<your-grok-bot-routine-webhook-url>
# Bearer key for that webhook. Either set it here...
WECHAT_WEBHOOK_KEY=<your-webhook-bearer-key>
# ...or leave it empty and point to a JSON file that contains "WECHAT_WEBHOOK_KEY" (top level or one level deep).
# WECHAT_SECRETS_FILE=/path/to/secrets.json
# WECHAT_WEBHOOK_ALLOW_LOCAL=0

# ---- optional ----
# Where credentials.json / state.json / pending.json / outbox.json / history.log / logs live (default: this dir)
# BRIDGE_DATA_DIR=/path/to/private/data
# Where downloaded WeChat images/files/voice/video are saved (default: $BRIDGE_DATA_DIR/attachments).
# Put it somewhere the agent can read, e.g. the agent's attachments folder.
# WECHAT_ATTACH_DIR=/path/to/agent/attachments/wechat

# Display labels only (NOT an allowlist — owner comes from bind credentials.json ilink_user_id)
OWNER_NAME=User
BOT_NAME=grok
# Prefix for app-initiated pushes (send.py --app) and the default keep-alive nudge
APP_PREFIX="[grok bot] "
# NUDGE_TEXT="[grok bot] 离你上次发消息快一天了，回个 1 续一下，免得之后的提醒发不过来。"

# Batching: flush after the user pauses BATCH_QUIET_S seconds, or at most BATCH_CAP_S after the first message
BATCH_QUIET_S=3
BATCH_CAP_S=60

# Quiet hours for the keep-alive nudge, in QUIET_TZ (default 00:00-07:59 Beijing)
QUIET_TZ=Asia/Shanghai
QUIET_START=0
QUIET_END=8
HISTORY_TZ=Asia/Shanghai
